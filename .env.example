# Copia questo file in .env per lo sviluppo locale. Su Vercel le stesse variabili vanno in
# Settings → Environment Variables (tipo Secret).

# GEMINI_API_KEY: chiave di Google AI Studio per la chat (usata solo dal server, mai dal browser).
GEMINI_API_KEY=""

# GEMINI_MODEL: modello della chat (facoltativo). Predefinito: gemini-3.5-flash-lite.
GEMINI_MODEL=""
